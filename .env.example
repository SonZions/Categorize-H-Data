# OpenAI API-Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Pad naar de SQLite-database
DB_PATH=data.db

# Brontabel met de te classificeren verslagen
SOURCE_TABLE=deelnemers_geaggregeerd
ID_COLUMN=Deelnemersnummer
TEXT_COLUMN=tekst

# Doeltabel voor de classificatie-resultaten (wordt automatisch aangemaakt)
RESULT_TABLE=classificatie_resultaten

# Model en batchgrootte
# gpt-4o-mini is goedkoop; voor lastige medische teksten evt. gpt-4o
OPENAI_MODEL=gpt-4o-mini
BATCH_SIZE=5
