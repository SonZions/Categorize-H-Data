# OpenAI API-Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Pfad zur SQLite-Datenbank
DB_PATH=data.db

# Tabellen- und Spaltennamen in der Datenbank
TABLE_NAME=texte
ID_COLUMN=id
TEXT_COLUMN=text
CATEGORY_COLUMN=kategorie

# Modell und Batchgroesse
OPENAI_MODEL=gpt-4o-mini
BATCH_SIZE=10

# Pfad zur JSON-Datei mit Kategorien und ihren Beschreibungen.
# Format: { "Kategoriename": "ausfuehrliche Beschreibung", ... }
# Vorlage: categories.example.json -> kopieren zu categories.json und anpassen.
CATEGORIES_FILE=categories.json
