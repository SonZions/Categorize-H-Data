# OpenAI API-Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Pfad zur SQLite-Datenbank
DB_PATH=data.db

# Tabellen- und Spaltennamen in der Datenbank
TABLE_NAME=texte
ID_COLUMN=id
TEXT_COLUMN=text
CATEGORY_COLUMN=kategorie

# Modell und Batchgroesse
OPENAI_MODEL=gpt-4o-mini
BATCH_SIZE=10

# Optional: Komma-getrennte Liste erlaubter Kategorien.
# Leer lassen, damit das Modell die Kategorie frei waehlt.
CATEGORIES=Rechnung,Vertrag,Privat,Werbung,Behoerde,Sonstiges
